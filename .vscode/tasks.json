{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Minecraft: Build + Server neu starten",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev-server.sh",
      "args": ["restart"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Minecraft: Nur bauen + Plugin installieren",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev-server.sh",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Minecraft: Server starten",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev-server.sh",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Minecraft: Server stoppen",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev-server.sh",
      "args": ["stop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Minecraft: Server-Log anzeigen",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev-server.sh",
      "args": ["logs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
